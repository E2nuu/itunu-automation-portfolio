    {
      "parameters": {
        "jsCode": "const TOTAL_SLOTS = 4;\nconst todayStr = new Date().toISOString().split('T')[0];\n\nconst eligible = items.filter((item) => {\n  const f = item.json;\n  \n  // 1. Clean the fields\n  const status = String(f.STATUS || \"\").trim().toUpperCase();\n  const interested = String(f.INTERESTED || \"\").trim();\n  const nextDate = String(f.Next_Send_Date || \"\").trim();\n\n  // 2. The Logic\n  const isReady = status === \"READY\";\n  const noInterest = interested === \"\"; // Row 2 fails here because of \"Filled Form\"\n  const isDue = nextDate === \"\" || nextDate <= todayStr;\n\n  return isReady && noInterest && isDue;\n});\n\n// 3. Sort them: Retargets (2, 3, 4) first, then Initials (1)\neligible.sort((a, b) => {\n  const stepA = String(a.json.Step_Number || \"\");\n  const stepB = String(b.json.Step_Number || \"\");\n  return stepB.localeCompare(stepA); \n});\n\n// 4. Return the top 4\nreturn eligible.slice(0, TOTAL_SLOTS);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
