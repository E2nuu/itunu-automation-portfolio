      "parameters": {
        "jsCode": "// Get all items (rows) from the node named \"if\"\nconst allRows = $items(\"MERGE\").map(item => item.json);\n\n// You can now inspect or return them\nreturn allRows.map((row, index) => ({\n  json: {\n    index: index + 1,\n    ...row,\n  }\n}));"
