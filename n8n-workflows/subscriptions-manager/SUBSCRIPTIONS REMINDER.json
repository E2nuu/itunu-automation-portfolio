    {
      "parameters": {
        "jsCode": "/**\n * 💳 Smart Next Payment Date Calculator\n * - Reads from node \"Loop Over Items\"\n * - Uses ISO \"RENEWAL DATE\" (YYYY-MM-DD)\n * - Adds days based on FREQUENCY:\n *     Monthly → +28 days\n *     Quarterly → +84 days\n *     Annual/Yearly → +365 days\n * - Returns ISO \"nextPaymentDate\"\n */\n\nconst SOURCE_NODE = \"Loop Over Items\"; // name of node with details\n\n// get the current item’s data from that node\nconst source = $item(0).$node[SOURCE_NODE].json;\n\n// pull date and frequency\nconst renewalDate = source[\"RENEWAL DATE\"];\nconst frequency = (source[\"FREQUENCY\"] || \"\").toLowerCase().trim();\n\n// basic validation\nif (!renewalDate) {\n  return {\n    json: {\n      error: \"❌ Missing RENEWAL DATE in source node\",\n      sourceNode: SOURCE_NODE,\n    },\n  };\n}\n\nconst parsed = new Date(renewalDate);\nif (isNaN(parsed.getTime())) {\n  return {\n    json: {\n      error: `❌ Invalid RENEWAL DATE format: ${renewalDate}`,\n      sourceNode: SOURCE_NODE,\n    },\n  };\n}\n\n// calculate days to add based on frequency\nlet daysToAdd = 28; // default = monthly\nif (frequency.includes(\"quarter\")) daysToAdd = 84;\nelse if (frequency.includes(\"year\") || frequency.includes(\"annual\")) daysToAdd = 365;\n\n// add days\nparsed.setDate(parsed.getDate() + daysToAdd);\nconst nextPaymentDate = parsed.toISOString().slice(0, 10); // ISO YYYY-MM-DD\n\nreturn {\n  json: {\n    originalDate: renewalDate,\n    frequency,\n    daysAdded: daysToAdd,\n    nextPaymentDate,\n  },\n};"
      },
