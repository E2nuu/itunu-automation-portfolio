    {
      "parameters": {
        "jsCode": "function pickRandom(arr) {\n  return arr[Math.floor(Math.random() * arr.length)];\n}\n\nfunction deriveFocusTag(rawFocus) {\n  if (!rawFocus) return null;\n\n  const focus = rawFocus.toLowerCase();\n\n  if (focus.includes(\"ai\")) return \"AI-driven automation\";\n  if (focus.includes(\"automation\")) return \"workflow automation\";\n  if (focus.includes(\"api\")) return \"API-driven development\";\n  if (focus.includes(\"scaling\")) return \"scaling internal systems\";\n  if (focus.includes(\"product\")) return \"product iteration and delivery\";\n  if (focus.includes(\"efficien\")) return \"operational efficiency\";\n  if (focus.includes(\"tool\")) return \"internal tooling improvements\";\n  if (focus.includes(\"innovation\")) return \"driving innovation\";\n\n  return null; // no confident signal\n}\n\nreturn items.map(item => {\n  const role = item.json[\"ROLE\"] || \"Job Application\";\n  const rawFocus = item.json[\"Company current Focus\"] || \"\";\n  const focusTag = deriveFocusTag(rawFocus);\n\n  /* ---------------- SUBJECT LINES ---------------- */\n\n  const subjectPool = [\n    `Application for ${role}`,\n    `${role} application`,\n    `${role} position`,\n    `Applying for ${role}`,\n    `Application — ${role}`,\n    `Job application for ${role}`,\n    `${role} role application`,\n    `Application: ${role}`,\n    `${role} job application`,\n    `Applying for the ${role} role`,\n    `Application for the ${role} role`,\n    `${role} opportunity application`,\n    `Application regarding ${role}`,\n    `${role} role — application`,\n    `Application submission — ${role}`,\n    `${role} application submission`,\n    `Application for open ${role} position`,\n    `${role} — job application`,\n    `Application for available ${role} role`,\n    `Application for ${role} position`\n  ];\n\n  /* ---------------- OPENING LINE ---------------- */\n\n  const openingLinePool = focusTag\n    ? [\n        `It’s clear your team is focused on ${focusTag}.`,\n        `Your focus on ${focusTag} stood out to me.`,\n        `From what I’ve seen, ${focusTag} is a key priority.`,\n        `The emphasis your team places on ${focusTag} caught my attention.`\n      ]\n    : [\n        `Your team’s recent direction stood out to me.`,\n        `I’ve been following the work your team is doing with interest.`,\n        `It’s clear your team is actively building and iterating.`,\n        `The pace at which your team is moving stood out to me.`\n      ];\n\n  /* ---------------- SIGNATURE ---------------- */\n\n  const signature = `\n<hr style=\"border:none;border-top:1px solid #2c2c2c;margin:14px 0;\">\n\n<p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.4;\">\nKind Regards,<br>\n<strong>Itunu Ola</strong><br>\nn8n Automation Specialist\n</p>\n\n<p style=\"margin:10px 0 0 0;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;\">\n🧑‍💻 <a href=\"https://github.com/E2nuu/itunu-automation-portfolio/tree/main\" style=\"color:#4da3ff;text-decoration:none;\">GitHub Portfolio</a><br>\n⚙️ <a href=\"https://n8n.io/creators/e2nu/\" style=\"color:#4da3ff;text-decoration:none;\">n8n Creator Portfolio</a><br>\n🛒 <a href=\"https://e2nu.gumroad.com/\" style=\"color:#4da3ff;text-decoration:none;\">Gumroad</a>\n&nbsp;&nbsp;🔗 <a href=\"https://www.linkedin.com/in/itunu-ola-ba7b07156/\" style=\"color:#4da3ff;text-decoration:none;\">LinkedIn</a>\n</p>\n`;\n\n  return {\n    json: {\n      ...item.json,\n      \"Subject Line\": pickRandom(subjectPool),\n      \"Opening Line\": pickRandom(openingLinePool),\n      \"Signature\": signature\n    }\n  };\n});"
      },
