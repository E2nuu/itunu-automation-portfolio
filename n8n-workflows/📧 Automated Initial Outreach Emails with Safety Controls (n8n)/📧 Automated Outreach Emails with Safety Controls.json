    },
    {
      "parameters": {
        "content": "## STEP 2:  Clean and Validate Emails\n\n\nThis step:\n• Fixes formatting issues\n• Blocks known bad domains\n• Rejects invalid email formats\n• Flags risky addresses\n\n",
        "height": 656,
        "width": 416,
        "color": 7
