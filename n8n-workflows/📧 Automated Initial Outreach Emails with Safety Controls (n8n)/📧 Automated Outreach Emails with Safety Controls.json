      "parameters": {
        "jsCode": "// === Daily Email Counter with Weekend Exclusion & Category Tracking ===\n\n// ✅ 1. Get today's date and day of week\nconst now = new Date();\nconst today = now.toISOString().split('T')[0];\nconst day = now.getDay(); // 0 = Sunday, 6 = Saturday\n\n// ✅ 2. Skip weekends automatically\nif (day === 0 || day === 6) {\n  console.log(\"🚫 Weekend detected. Skipping all email sends today.\");\n  return []; // Stop workflow on weekends\n}\n\n// ✅ 3. Set your total daily Gmail quota\nconst totalLimit = 100;  // adjust if needed\n\n// ✅ 4. Access persistent storage (shared across all workflows)\nconst data = $getWorkflowStaticData('global');\n\n// ✅ 5. Reset if new day\nif (!data.sentCountDate || data.sentCountDate !== today) {\n  data.sentCountDate = today;\n  data.sentCount = 0;\n  data.breakdown = { initial: 0, retarget1: 0, retarget2: 0, reply: 0 };\n}\n\n// ✅ 6. Read email type passed from the Set node\nconst emailType = $json.emailType || 'unknown';\n\n// ✅ 7. Stop all if total daily quota is reached\nif (data.sentCount >= totalLimit) {\n  console.log(`🚫 Daily Gmail quota reached (${data.sentCount}/${totalLimit}).`);\n  return [];\n}\n\n// ✅ 8. Define category-specific ratios (adjust to your liking)\nconst ratios = {\n  initial: 0.55,   // 55% for new hot leads\n  retarget1: 0.20, // 20% for first follow-up\n  retarget2: 0.15, // 15% for second follow-up\n  reply: 0.10,     // 10% for ongoing replies\n};\n\n// ✅ 9. Compute local quota per category\nconst localLimit = Math.floor(totalLimit * (ratios[emailType] || 0.25));\n\n// ✅ 10. Skip sending if that category is full\nif (data.breakdown[emailType] >= localLimit) {\n  console.log(`⏸ ${emailType} quota full (${localLimit} max).`);\n  return [];\n}\n\n// ✅ 11. Increment counters\ndata.sentCount += 1;\nif (!data.breakdown[emailType]) data.breakdown[emailType] = 0;\ndata.breakdown[emailType] += 1;\n\n// ✅ 12. Log updates\nconsole.log(`📩 Sent #${data.sentCount}/${totalLimit} | Type: ${emailType}`);\nconsole.log(`📊 Breakdown: ${JSON.stringify(data.breakdown)}`);\n\n// ✅ 13. Allow sending to continue\nreturn items;"
      },
