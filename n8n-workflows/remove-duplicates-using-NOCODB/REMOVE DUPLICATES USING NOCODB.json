      "name": "Remove Duplicates",
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Get the results of both nodes\nconst allRows = $items(\"GET REQUIRED SHEET\"); // Original\nconst uniqueRows = $items(\"Remove Duplicates\");   // After deduplication\n\n// Build lookup of unique IDs\nconst uniqueIds = new Set(uniqueRows.map(r => r.json.Id));\n\n// Find which ones were removed (duplicates)\nconst duplicates = allRows\n  .filter(r => !uniqueIds.has(r.json.Id))\n  .map(r => r.json);\n\n// Return the duplicate records\nreturn duplicates.map(d => ({\n  json: {\n    Id: d.Id,\n    ...d\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        -208
      ],
      "id": "6bd09f23-8924-4297-a1e3-e80fc203335f",
      "name": "DUPLICATES IDS"
    },
    {
      "parameters": {
        "jsCode": "// Get full data set (before deduplication)\nconst allRows = $items(\"GET REQUIRED SHEET\");  // original\n// Get the deduplicated list (after duplicates removed)\nconst uniqueRows = $items(\"Remove Duplicates\");    \n\n// Build lookup of unique IDs\nconst uniqueIds = new Set(uniqueRows.map(r => r.json.Id));\n\n// Find duplicates\nconst duplicates = allRows.filter(r => !uniqueIds.has(r.json.Id));\n\n// Extract just the IDs\nconst duplicateIds = duplicates.map(r => r.json.Id);\n\n// Return as single JSON output (array)\nreturn [\n  {\n    json: {\n      ids: duplicateIds\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
